# Copy to .env at the repository root and fill in. Never commit .env.

# Supabase (Project Settings > API Keys; the database URL is under Connect > Transaction pooler)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Model providers
VOYAGE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional overrides, as provider:model (defaults and reasons in docs/adr/0010)
# ANSWER_MODEL=groq:openai/gpt-oss-120b
# FALLBACK_ANSWER_MODEL=gemini:gemini-3.5-flash-lite

# App
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
IP_HASH_SALT=

# Optional: a disposable Postgres with pgvector for the API's database tests.
# Never point this at a database you care about — tests drop and recreate the `app` schema.
TEST_DATABASE_URL=

# The web app reads its own file, apps/web/.env.local:
#   NEXT_PUBLIC_SUPABASE_URL=        (same as SUPABASE_URL)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   (same as SUPABASE_PUBLISHABLE_KEY)
#   API_BASE_URL=http://localhost:8000
