            "title": "Collection Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "collection_id",
          "name",
          "size_bytes",
          "sha256"
        ],
        "title": "NewDocument",
        "type": "object"
      },
      "PassageOut": {
        "properties": {
          "after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
