  "info": {
    "title": "Docent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/answers": {
      "post": {
        "description": "Answer a question from the User's Documents, streamed, citing passages as [n].",
        "operationId": "askQuestion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Question"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Server-sent events, in order:\n\n- `start`: `{conversation_id, message_id, sources: [{number, document_id, document_name,\n  heading_path, page}]}`, the passages the answer may cite, numbered as in `[n]`\n- `delta`: `{text}`, the next piece of the answer\n- `done`: `{message_id, outcome: \"answered\" | \"declined\", cited: [n, ...]}`\n- `error`: `{message, partial}`, the answer stopped; `partial` if some text was sent\n"
          },
          "404": {
            "description": "No such Conversation"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ask",
        "tags": [
          "answers"
        ]
      }
    },
    "/conversations/{conversation_id}": {
      "get": {
        "description": "A saved Conversation with its answers and their Citations.",
        "operationId": "getConversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Conversation",
        "tags": [
          "answers"
        ]
      }
    },
    "/documents": {
      "get": {
        "description": "Every Document in the signed-in User's Collections, newest first.",
        "operationId": "listDocuments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  },
                  "title": "Response Listdocuments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Documents",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "description": "Add a Document: returns where to upload its file. Call `finishUpload` afterwards.",
        "operationId": "startUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDocument"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedUpload"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "The file breaks an upload rule"
          },
          "409": {
            "description": "The Collection already has a Document with this content"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "New Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}": {
      "delete": {
        "description": "Delete a Document with its file, passages, and vectors. Repeating the call is harmless.",
        "operationId": "deleteDocument",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/retry": {
      "post": {
        "description": "Queue a failed Document again, when retrying could help.",
        "operationId": "retryDocument",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Retry",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/uploaded": {
      "post": {
        "description": "The file is stored: queue the Document for ingestion.",
        "operationId": "finishUpload",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Uploaded",
        "tags": [
          "documents"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report that the API is running and which version is deployed.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/health/database": {
      "get": {
        "description": "Report that the database answers. Pinged on a schedule so the free database never pauses.",
        "operationId": "getDatabaseHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Database Health",
        "tags": [
          "system"
        ]
      }
    },
    "/ingestion/run": {
      "post": {
        "description": "Process queued Documents for a few minutes. Returns at once if a batch is already running,\nso calling it again can't multiply the work.",
        "operationId": "runIngestion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionRun"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Run Ingestion",
        "tags": [
          "documents"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "The signed-in User and their Collections. Creates both on first sign-in.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "library"
        ]
      }
    },
    "/passages/{chunk_id}": {
      "get": {
        "description": "A passage the User can read, with its neighbours, for showing a Citation in context.",
        "operationId": "getPassage",
        "parameters": [
          {
            "in": "path",
            "name": "chunk_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Chunk Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PassageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Passage",
        "tags": [
          "answers"
        ]
      }
    }
  }
}
