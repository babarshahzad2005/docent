{
  "components": {
    "schemas": {
      "CollectionSummary": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_personal": {
            "title": "Is Personal",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "editor",
              "viewer"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "is_personal",
          "role"
        ],
        "title": "CollectionSummary",
        "type": "object"
      },
      "DocumentSummary": {
        "properties": {
          "collection_id": {
            "format": "uuid",
            "title": "Collection Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "effective_date": {
            "format": "date",
            "title": "Effective Date",
            "type": "string"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "status": {
            "enum": [
              "uploading",
              "queued",
              "parsing",
              "embedding",
              "indexed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "collection_id",
          "name",
          "size_bytes",
          "status",
          "failure_reason",
          "effective_date",
          "created_at",
          "updated_at"
        ],
        "title": "DocumentSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "IngestionRun": {
        "properties": {
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "indexed": {
            "title": "Indexed",
            "type": "integer"
          },
          "ran": {
            "title": "Ran",
            "type": "boolean"
          },
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          }
        },
        "required": [
          "indexed",
          "failed",
          "remaining",
          "ran"
        ],
        "title": "IngestionRun",
        "type": "object"
      },
      "Me": {
        "properties": {
          "collections": {
            "items": {
              "$ref": "#/components/schemas/CollectionSummary"
            },
            "title": "Collections",
            "type": "array"
          },
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "collections"
        ],
        "title": "Me",
        "type": "object"
      },
      "NewDocument": {
        "properties": {
          "collection_id": {
            "format": "uuid",
            "title": "Collection Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "collection_id",
          "name",
          "size_bytes"
        ],
        "title": "NewDocument",
        "type": "object"
      },
      "StartedUpload": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadTarget"
          }
        },
        "required": [
          "document",
          "upload"
        ],
        "title": "StartedUpload",
        "type": "object"
      },
      "UploadTarget": {
        "description": "Where the browser uploads the file, with Supabase's `uploadToSignedUrl`.",
        "properties": {
          "bucket": {
            "title": "Bucket",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "bucket",
          "path",
          "token"
        ],
        "title": "UploadTarget",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Docent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/documents": {
      "get": {
        "description": "Every Document in the signed-in User's Collections, newest first.",
        "operationId": "listDocuments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  },
                  "title": "Response Listdocuments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Documents",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "description": "Add a Document: returns where to upload its file. Call `finishUpload` afterwards.",
        "operationId": "startUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDocument"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedUpload"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "The file breaks an upload rule"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "New Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/uploaded": {
      "post": {
        "description": "The file is stored: queue the Document for ingestion.",
        "operationId": "finishUpload",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Uploaded",
        "tags": [
          "documents"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report that the API is running and which version is deployed.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/health/database": {
      "get": {
        "description": "Report that the database answers. Pinged on a schedule so the free database never pauses.",
        "operationId": "getDatabaseHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Database Health",
        "tags": [
          "system"
        ]
      }
    },
    "/ingestion/run": {
      "post": {
        "description": "Process queued Documents for a few minutes. Returns at once if a batch is already running,\nso calling it again can't multiply the work.",
        "operationId": "runIngestion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionRun"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Run Ingestion",
        "tags": [
          "documents"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "The signed-in User and their Collections. Creates both on first sign-in.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "library"
        ]
      }
    }
  }
}
